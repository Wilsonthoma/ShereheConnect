// =====================================================
// SHEREHECONNECT DATABASE SCHEMA
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum UserRole {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OrganizerType {
  INDIVIDUAL
  BUSINESS
  NGO
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVISION
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentMethodType {
  PAYBILL
  TILL
  POCHI
  SEND_MONEY
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  NEEDS_REVISION
  APPROVED
  LIVE
  ONGOING
  COMPLETED
  CANCELLED
  REJECTED
}

enum ReviewAction {
  APPROVED
  REJECTED
  REQUESTED_CHANGES
}

enum BookingStatus {
  PENDING
  PAYMENT_RECEIVED
  CONFIRMED
  EXPIRED
  FAILED
  CANCELLED
  CHECKED_IN
}

enum PaymentType {
  TICKET_PAYMENT
  SUBSCRIPTION_PAYMENT
}

enum PaymentMethodApi {
  MPESA_C2B
  MPESA_STK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  MISMATCHED
}

enum TicketStatus {
  ISSUED
  SCANNED
  REVOKED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------- CORE USERS ----------

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String     @unique
  phone          String     @unique @db.VarChar(20)
  passwordHash   String     @map("password_hash")
  fullName       String     @map("full_name") @db.VarChar(200)
  role           UserRole   @default(ATTENDEE)
  status         UserStatus @default(ACTIVE)

  emailVerified  Boolean    @default(false) @map("email_verified")
  phoneVerified  Boolean    @default(false) @map("phone_verified")

  emailVerificationToken     String?   @map("email_verification_token")
  emailVerificationAttempts  Int       @default(0) @map("email_verification_attempts")
  emailVerificationExpires   DateTime? @map("email_verification_expires") @db.Timestamptz
  emailVerifiedAt            DateTime? @map("email_verified_at") @db.Timestamptz

  passwordResetToken         String?   @map("password_reset_token")
  passwordResetExpires       DateTime? @map("password_reset_expires") @db.Timestamptz
  passwordChangedAt          DateTime? @map("password_changed_at") @db.Timestamptz

  profileImageUrl String?   @map("profile_image_url")
  lastLoginAt    DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  organizerProfile       OrganizerProfile?
  bookings               Booking[]
  approvedEvents         Event[]              @relation("EventApprover")
  eventReviews           EventReview[]
  scannedTickets         ETicket[]            @relation("TicketScanner")
  notifications          Notification[]
  auditLogs              AuditLog[]
  organizerKycReviews    OrganizerProfile[]   @relation("KycReviewer")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
  @@map("users")
}

// ---------- ORGANIZER ----------

model OrganizerProfile {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @unique @map("user_id") @db.Uuid
  businessName     String        @map("business_name") @db.VarChar(200)
  organizerType    OrganizerType @default(INDIVIDUAL) @map("organizer_type")
  county           String        @db.VarChar(100)
  bio              String?
  kycStatus        KycStatus     @default(PENDING) @map("kyc_status")
  kycDocuments     Json          @default("[]") @map("kyc_documents")
  kycReviewedBy    String?       @map("kyc_reviewed_by") @db.Uuid
  kycReviewedAt    DateTime?     @map("kyc_reviewed_at") @db.Timestamptz
  kycNotes         String?       @map("kyc_notes")
  averageRating    Decimal       @default(0) @map("average_rating") @db.Decimal(3, 2)
  completedEvents  Int           @default(0) @map("completed_events")
  disputeCount     Int           @default(0) @map("dispute_count")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycReviewer      User?           @relation("KycReviewer", fields: [kycReviewedBy], references: [id])
  paymentMethods   PaymentMethod[]
  subscriptions    Subscription[]
  events           Event[]

  @@index([userId])
  @@index([kycStatus])
  @@map("organizer_profiles")
}

// ---------- SUBSCRIPTIONS ----------

model SubscriptionPlan {
  id                 String          @id @default(uuid()) @db.Uuid
  code               String          @unique @db.VarChar(50)
  name               String          @db.VarChar(100)
  priceKes           Int             @map("price_kes")
  billingInterval    BillingInterval @default(MONTHLY) @map("billing_interval")
  maxEventsPerMonth  Int?            @map("max_events_per_month")
  maxAttendeesEvent  Int?            @map("max_attendees_event")
  features           Json            @default("{}")
  isActive           Boolean         @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizerId        String             @map("organizer_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now()) @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz
  gracePeriodEnd     DateTime?          @map("grace_period_end") @db.Timestamptz
  retryCount         Int                @default(0) @map("retry_count")
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  organizer OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  payments  Payment[]

  @@index([organizerId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// ---------- PAYMENT METHODS ----------

model PaymentMethod {
  id             String            @id @default(uuid()) @db.Uuid
  organizerId    String            @map("organizer_id") @db.Uuid
  methodType     PaymentMethodType @map("method_type")
  shortcode      String?           @db.VarChar(20)
  accountNumber  String?           @map("account_number") @db.VarChar(50)
  phoneNumber    String?           @map("phone_number") @db.VarChar(20)
  displayLabel   String?           @map("display_label") @db.VarChar(100)
  c2bRegistered  Boolean           @default(false) @map("c2b_registered")
  isActive       Boolean           @default(true) @map("is_active")
  isDefault      Boolean           @default(false) @map("is_default")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organizer OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@index([organizerId, isActive])
  @@map("payment_methods")
}

// ---------- EVENTS ----------

model EventCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  iconUrl   String?  @map("icon_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  events Event[]

  @@map("event_categories")
}

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  organizerId     String      @map("organizer_id") @db.Uuid
  categoryId      String?     @map("category_id") @db.Uuid
  title           String      @db.VarChar(300)
  slug            String      @unique @db.VarChar(320)
  description     String
  coverImageUrl   String?     @map("cover_image_url")
  galleryUrls     Json        @default("[]") @map("gallery_urls")
  venueName       String      @map("venue_name") @db.VarChar(200)
  address         String
  county          String      @db.VarChar(100)
  latitude        Float?
  longitude       Float?
  startsAt        DateTime    @map("starts_at") @db.Timestamptz
  endsAt          DateTime    @map("ends_at") @db.Timestamptz
  timezone        String      @default("Africa/Nairobi") @db.VarChar(50)
  status          EventStatus @default(DRAFT)
  submittedAt     DateTime?   @map("submitted_at") @db.Timestamptz
  approvedAt      DateTime?   @map("approved_at") @db.Timestamptz
  approvedBy      String?     @map("approved_by") @db.Uuid
  rejectionReason String?     @map("rejection_reason")
  maxAttendees    Int?        @map("max_attendees")
  isFeatured      Boolean     @default(false) @map("is_featured")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  organizer  OrganizerProfile @relation(fields: [organizerId], references: [id])
  category   EventCategory?   @relation(fields: [categoryId], references: [id])
  approver   User?            @relation("EventApprover", fields: [approvedBy], references: [id])
  reviews    EventReview[]
  ticketTiers TicketTier[]
  bookings   Booking[]

  @@index([organizerId])
  @@index([status])
  @@index([startsAt])
  @@index([county])
  @@index([categoryId])
  @@map("events")
}

model EventReview {
  id        String       @id @default(uuid()) @db.Uuid
  eventId   String       @map("event_id") @db.Uuid
  adminId   String       @map("admin_id") @db.Uuid
  action    ReviewAction
  notes     String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  admin User  @relation(fields: [adminId], references: [id])

  @@index([eventId])
  @@index([adminId])
  @@map("event_reviews")
}

model TicketTier {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  name             String   @db.VarChar(100)
  description      String?
  priceKes         Int      @map("price_kes")
  quantityTotal    Int      @map("quantity_total")
  quantitySold     Int      @default(0) @map("quantity_sold")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  salesStartAt     DateTime? @map("sales_start_at") @db.Timestamptz
  salesEndAt       DateTime? @map("sales_end_at") @db.Timestamptz
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([eventId])
  @@index([eventId, isActive])
  @@map("ticket_tiers")
}

// ---------- BOOKINGS ----------

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  bookingReference   String        @unique @map("booking_reference") @db.VarChar(50)
  attendeeId         String        @map("attendee_id") @db.Uuid
  eventId            String        @map("event_id") @db.Uuid
  ticketTierId       String        @map("ticket_tier_id") @db.Uuid
  quantity           Int
  unitPriceKes       Int           @map("unit_price_kes")
  totalAmountKes     Int           @map("total_amount_kes")
  status             BookingStatus @default(PENDING)
  expiresAt          DateTime      @map("expires_at") @db.Timestamptz
  confirmedAt        DateTime?     @map("confirmed_at") @db.Timestamptz
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz
  cancellationReason String?       @map("cancellation_reason")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  attendee   User       @relation(fields: [attendeeId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id])
  ticketTier TicketTier @relation(fields: [ticketTierId], references: [id])
  payments   Payment[]
  eTicket    ETicket?

  @@index([bookingReference])
  @@index([attendeeId])
  @@index([eventId])
  @@index([status])
  @@index([ticketTierId])
  @@map("bookings")
}

// ---------- PAYMENTS ----------

model Payment {
  id                 String           @id @default(uuid()) @db.Uuid
  bookingId          String?          @map("booking_id") @db.Uuid
  subscriptionId     String?          @map("subscription_id") @db.Uuid
  paymentType        PaymentType      @map("payment_type")
  method             PaymentMethodApi
  amountKes          Int              @map("amount_kes")
  mpesaReceipt       String?          @unique @map("mpesa_receipt") @db.VarChar(50)
  mpesaPhone         String?          @map("mpesa_phone") @db.VarChar(20)
  billReference      String?          @map("bill_reference") @db.VarChar(100)
  checkoutRequestId  String?          @map("checkout_request_id") @db.VarChar(100)
  merchantRequestId  String?          @map("merchant_request_id") @db.VarChar(100)
  rawCallbackPayload Json?            @map("raw_callback_payload")
  status             PaymentStatus    @default(PENDING)
  failureReason      String?          @map("failure_reason")
  processedAt        DateTime?        @map("processed_at") @db.Timestamptz
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  booking      Booking?      @relation(fields: [bookingId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([bookingId])
  @@index([subscriptionId])
  @@index([mpesaReceipt])
  @@index([status])
  @@index([paymentType])
  @@index([checkoutRequestId])
  @@map("payments")
}

// ---------- E-TICKETS ----------

model ETicket {
  id                String       @id @default(uuid()) @db.Uuid
  bookingId         String       @unique @map("booking_id") @db.Uuid
  ticketCode        String       @unique @map("ticket_code") @db.VarChar(50)
  qrToken           String       @map("qr_token")
  status            TicketStatus @default(ISSUED)
  issuedAt          DateTime     @default(now()) @map("issued_at") @db.Timestamptz
  scannedAt         DateTime?    @map("scanned_at") @db.Timestamptz
  scannedBy         String?      @map("scanned_by") @db.Uuid
  scanCount         Int          @default(0) @map("scan_count")
  revokedAt         DateTime?    @map("revoked_at") @db.Timestamptz
  revocationReason  String?      @map("revocation_reason")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  scanner   User?   @relation("TicketScanner", fields: [scannedBy], references: [id])

  @@index([ticketCode])
  @@index([status])
  @@map("e_tickets")
}

// ---------- NOTIFICATIONS ----------

model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  type          String              @db.VarChar(80)
  title         String              @db.VarChar(200)
  message       String
  channel       NotificationChannel @default(IN_APP)
  status        NotificationStatus  @default(PENDING)
  metadata      Json                @default("{}")
  readAt        DateTime?           @map("read_at") @db.Timestamptz
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz
  failureReason String?             @map("failure_reason")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

// ---------- AUDIT LOGS ----------

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  userId     String?   @map("user_id") @db.Uuid
  action     String    @db.VarChar(80)
  entityType String    @map("entity_type") @db.VarChar(50)
  entityId   String?   @map("entity_id") @db.Uuid
  changes    Json?
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
